const long g = 0x2A;
float pi = 3.14;
int pick(int, int value);
int sum(int a, int b);
void noop(void);

int pick(int first, int value) {
  return value;
}

int sum(int a, int b) {
  return a + b;
}

void noop(void) {
  return;
}

int main() {
  int arr[2];
  int x = 1;
  bool flag = !0 && 1 || 0;
  float local = 1.5;

  x = (x = x + 1, x + 2);
  noop();

label:
  for (int i = 0; i < 2; i = i + 1, x = x + i) {
    if (i == 1) {
      continue;
    } else {
      arr[i] = g & i | 0;
    }
  }

  switch (g) {
    case 1:
      x = sum(x, arr[0]);
      break;
    default:
      x = pick(x, x + 1);
      break;
  }

  do {
    goto label;
  } while (g >= 1 && flag);

  return 42;
}

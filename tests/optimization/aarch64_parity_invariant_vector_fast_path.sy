int left[1000][1000];
int right[1000][1000];
int output[1000][1000];

int main() {
    left[0][0] = 1;
    left[0][1] = -3;
    left[0][2] = 4;
    left[1][0] = -5;
    left[1][1] = 6;
    left[2][0] = 7;
    left[2][2] = -8;
    left[17][9] = 11;
    left[31][23] = -12;

    int i = 0;
    int j = 0;
    int k = 0;
    int total = 0;

    while (i < 1000) {
        j = 0;
        while (j < 1000) {
            right[i][j] = left[j][i];
            j = j + 1;
        }
        i = i + 1;
    }

    i = 0;
    while (i < 1000) {
        j = 0;
        while (j < 1000) {
            k = 0;
            int temp = 0;
            while (k < 1000) {
                if (left[i][k] * right[k][j] % 2 == 0) {
                    temp = temp + right[i][k] * left[k][j];
                }
                k = k + 1;
            }
            output[i][j] = temp;
            j = j + 1;
        }
        i = i + 1;
    }

    i = 0;
    while (i < 1000) {
        j = 0;
        int minimum = 2147483647;
        while (j < 1000) {
            if (output[i][j] < minimum) {
                minimum = output[i][j];
            }
            j = j + 1;
        }
        j = 0;
        while (j < 1000) {
            output[i][j] = minimum;
            j = j + 1;
        }
        i = i + 1;
    }

    i = 0;
    while (i < 1000) {
        j = 0;
        while (j < 1000) {
            output[i][j] = -output[j][i];
            j = j + 1;
        }
        i = i + 1;
    }

    i = 0;
    while (i < 1000) {
        j = 0;
        while (j < 1000) {
            total = total + output[i][j];
            j = j + 1;
        }
        i = i + 1;
    }

    putint(total);
    putch(10);
    return 0;
}

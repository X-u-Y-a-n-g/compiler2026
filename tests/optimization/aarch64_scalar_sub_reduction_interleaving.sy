int left_values[9];
int right_values[9];

int main() {
  int accumulator, index, length;

  left_values[0] = 2147483647;
  left_values[1] = -2147483647 - 1;
  left_values[2] = 46341;
  left_values[3] = -65537;
  left_values[4] = 17;
  left_values[5] = -29;
  left_values[6] = 1000000007;
  left_values[7] = -123456789;
  left_values[8] = 31;

  right_values[0] = -1;
  right_values[1] = 3;
  right_values[2] = 46341;
  right_values[3] = -65537;
  right_values[4] = -19;
  right_values[5] = -37;
  right_values[6] = 97;
  right_values[7] = -17;
  right_values[8] = 41;

  length = 0;
  while (length < 10) {
    accumulator = 123456789;
    index = 0;
    while (index < length) {
      accumulator =
          accumulator - left_values[index] * right_values[index];
      index = index + 1;
    }
    putint(accumulator);
    putch(10);
    length = length + 1;
  }
  return 0;
}

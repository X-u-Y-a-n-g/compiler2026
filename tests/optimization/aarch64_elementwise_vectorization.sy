int first[20];
int second[20];
int output[20];

void initialize() {
  int index = 0;
  while (index < 20) {
    first[index] = index * 13 - 70;
    second[index] = 90 - index * 7;
    output[index] = index - 30;
    index = index + 1;
  }
}

void affine_combine(int destination[], int lhs[], int rhs[], int count) {
  int index = 0;
  while (index < count) {
    destination[index] = lhs[index] * 5 + rhs[index] * 9;
    index = index + 1;
  }
}

void square_divide(int data[], int count) {
  int index = 0;
  while (index < count) {
    data[index] = (data[index] * data[index] + 5) / 7;
    index = index + 1;
  }
}

void print_values(int data[], int count) {
  int index = 0;
  while (index < count) {
    if (index != 0) {
      putch(32);
    }
    putint(data[index]);
    index = index + 1;
  }
  putch(10);
}

int main() {
  initialize();
  affine_combine(output, first, second, 0);
  print_values(output, 3);

  initialize();
  affine_combine(output, first, second, 7);
  print_values(output, 9);

  initialize();
  affine_combine(first, first, second, 7);
  print_values(first, 9);

  initialize();
  first[0] = 50000;
  first[1] = -50000;
  square_divide(first, 7);
  print_values(first, 9);
  return 0;
}

int X[8][8];
int Y[8][8];
int Z[8][8];

int main() {
    int n = getint();
    int i = 0;
    while (i < n) {
        getarray(X[i]);
        getarray(Y[i]);
        i = i + 1;
    }

    i = 0;
    while (i < n) {
        int j = 0;
        while (j < n) {
            Z[i][j] = X[i][j] + Y[i][j];
            j = j + 1;
        }
        i = i + 1;
    }

    i = 0;
    while (i < n) {
        int j = 0;
        while (j < n) {
            Z[i][j] = Z[i][j] * 5 + X[i][j];
            j = j + 1;
        }
        i = i + 1;
    }

    int sum = 0;
    i = 0;
    while (i < n) {
        int j = 0;
        while (j < n) {
            sum = sum + Z[i][j];
            j = j + 1;
        }
        i = i + 1;
    }
    putint(sum);
    putch(10);
    return 0;
}

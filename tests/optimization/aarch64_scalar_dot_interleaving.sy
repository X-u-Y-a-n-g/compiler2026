int values[12][19];
int observed[12];

int strided_dot(int end, int column, int initial) {
  int index = 0;
  int result = initial;
  while (index < end) {
    result = result - values[0][index] * values[index][column];
    index = index + 1;
  }
  return result;
}

int step_two_fallback(int end, int column, int initial) {
  int index = 0;
  int result = initial;
  while (index < end) {
    result = result - values[0][index] * values[index][column];
    index = index + 2;
  }
  return result;
}

int store_fallback(int end, int column, int initial) {
  int index = 0;
  int result = initial;
  while (index < end) {
    result = result - values[0][index] * values[index][column];
    observed[index] = result;
    index = index + 1;
  }
  return result;
}

int main() {
  int row = 0;
  while (row < 12) {
    int column = 0;
    while (column < 19) {
      values[row][column] = row * 100003 + column * 31337 - 700001;
      column = column + 1;
    }
    row = row + 1;
  }
  values[0][3] = 2147483647;
  values[3][5] = 2147483647;
  values[0][7] = -2147483647 - 1;
  values[7][5] = -1;

  putint(strided_dot(0, 5, 123));
  putch(10);
  putint(strided_dot(1, 5, -77));
  putch(10);
  putint(strided_dot(2, 5, 19));
  putch(10);
  putint(strided_dot(3, 5, 19));
  putch(10);
  putint(strided_dot(7, 5, -2147483647 - 1));
  putch(10);
  putint(strided_dot(8, 5, 2147483647));
  putch(10);
  putint(strided_dot(9, 5, -123456789));
  putch(10);
  putint(step_two_fallback(9, 5, 33));
  putch(10);
  putint(store_fallback(9, 5, -44));
  putch(10);
  return 0;
}

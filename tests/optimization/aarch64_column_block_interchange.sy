int left[70][70];
int weight[70][70];

int evaluate(int n, int salt) {
    int i = 0;
    while (i < n) {
        int j = 0;
        while (j < n) {
            left[i][j] = i * 17 + j * 5 + salt;
            weight[i][j] = i * 3 - j * 11 + salt;
            j = j + 1;
        }
        i = i + 1;
    }

    i = 0;
    while (i < n) {
        int j = 0;
        while (j < n) {
            int k = 0;
            int sum = 0;
            while (k < n) {
                sum = sum + weight[i][k] * left[k][j];
                k = k + 1;
            }
            left[i][j] = sum;
            j = j + 1;
        }
        i = i + 1;
    }

    int answer = 0;
    i = 0;
    while (i < n) {
        int j = 0;
        while (j < n) {
            answer = answer * 31 + left[i][j];
            j = j + 1;
        }
        i = i + 1;
    }
    return answer;
}

int main() {
    int count = getint();
    int c = 0;
    while (c < count) {
        int n = getint();
        putint(evaluate(n, c + 1));
        putch(10);
        c = c + 1;
    }
    return 0;
}

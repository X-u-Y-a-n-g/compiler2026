int stable_values[5];
int observed[6];

int weighted_lookup(int key) {
  int index = 0;
  int result = key;
  while (index < 3) {
    result = result + stable_values[(key + index) % 5] * (index + 1);
    index = index + 1;
  }
  return result;
}

int main() {
  stable_values[0] = 2;
  stable_values[1] = 3;
  stable_values[2] = 5;
  stable_values[3] = 7;
  stable_values[4] = 11;

  int index = 0;
  while (index < 6) {
    int query = 5;
    if (index % 2 != 0) {
      query = 131077;
    }
    observed[index] = weighted_lookup(query);
    index = index + 1;
  }
  putarray(6, observed);
  return 0;
}

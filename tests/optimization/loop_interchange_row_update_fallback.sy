int matrix[8][8];
int calls;

int observe(int value) {
    calls = calls + 1;
    return value;
}

void update_rows(int n, int values[][8]) {
    int i;
    int j;
    int k;
    int current;
    i = 0;
    while (i < n) {
        j = i;
        while (j < n) {
            current = values[i][j];
            k = 0;
            while (k < i) {
                current = current - values[i][k] * observe(values[k][j]);
                k = k + 1;
            }
            values[i][j] = current;
            j = j + 1;
        }
        i = i + 1;
    }
}

int main() {
    int n = getint();
    getarray(matrix);
    update_rows(n, matrix);
    putarray(64, matrix);
    putint(calls);
    putch(10);
    return 0;
}

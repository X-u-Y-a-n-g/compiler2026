int sum_array(int a[], int n) {
  int i = 0;
  int sum = 0;
  while (i < n) {
    sum = sum + a[i];
    i = i + 1;
  }
  return sum;
}

int complete_overwrite(int seed) {
  int values[7] = {};
  int i;
  int sum;
  values[0] = seed;
  i = 1;
  while (i < 7) {
    values[i] = values[i - 1] + i;
    i = i + 1;
  }
  sum = 0;
  i = 0;
  while (i < 7) {
    sum = sum + values[i];
    i = i + 1;
  }
  return sum;
}

int read_before_overwrite() {
  int values[5] = {};
  int saved = values[3];
  int i;
  values[0] = 2;
  i = 1;
  while (i < 5) {
    values[i] = values[i - 1] + 1;
    i = i + 1;
  }
  return saved + values[4];
}

int incomplete_overwrite() {
  int values[6] = {};
  int i;
  values[0] = 3;
  i = 1;
  while (i < 5) {
    values[i] = values[i - 1] + 2;
    i = i + 1;
  }
  return values[5];
}

int escaped_array() {
  int values[4] = {};
  int i;
  values[0] = 1;
  i = 1;
  while (i < 4) {
    values[i] = values[i - 1] * 2;
    i = i + 1;
  }
  return sum_array(values, 4);
}

int main() {
  putint(complete_overwrite(4));
  putch(10);
  putint(read_before_overwrite());
  putch(10);
  putint(incomplete_overwrite());
  putch(10);
  putint(escaped_array());
  putch(10);
  return 0;
}

int data[32];

void ordered_shift(int count) {
    int i = 0;
    while (i < count) {
        data[i + 1] = data[i] + 1;
        i = i + 1;
    }
}

int boundary_tail() {
    int i = 2147483645;
    while (i < 2147483647) {
        data[i - 2147483645 + 16] = i - 2147483644;
        i = i + 1;
    }
    return data[16] + data[17];
}

int changing_bound_fallback(int count) {
    int total = 0;
    int i = 0;
    while (i < count) {
        total = total + i;
        count = count - 1;
        i = i + 1;
    }
    return total;
}

int main() {
    int seed = getint();
    data[0] = seed;

    ordered_shift(0);
    ordered_shift(1);
    ordered_shift(3);
    ordered_shift(4);
    ordered_shift(5);

    putarray(7, data);
    putint(boundary_tail());
    putch(10);
    putint(changing_bound_fallback(9));
    putch(10);
    return 0;
}

int divisor;

int runtime_remainder(int value) {
    return value % divisor;
}

int main() {
    int first = getint();
    int second = getint();
    int value = getint();
    divisor = first;
    int before = runtime_remainder(value);
    divisor = second;
    int after = runtime_remainder(value);
    putint(before);
    putch(10);
    putint(after);
    putch(10);
    return 0;
}

int hot[2][3] = {{1, 2, 3}, {4, 5, 6}};
int mixed_a[2][3] = {{7, 8, 9}, {10, 11, 12}};
int mixed_b[2][3] = {{13, 14, 15}, {16, 17, 18}};
int escaped[2][3] = {{19, 20, 21}, {22, 23, 24}};

int column_sum(int array[][3], int repeats) {
  int repeat = 0;
  int column;
  int row;
  int sum = 0;
  while (repeat < repeats) {
    column = 0;
    while (column < 3) {
      row = 0;
      while (row < 2) {
        sum = sum + array[row][column];
        row = row + 1;
      }
      column = column + 1;
    }
    repeat = repeat + 1;
  }
  return sum;
}

int mixed_sum(int array[][3]) {
  int column = 0;
  int row;
  int sum = 0;
  while (column < 3) {
    row = 0;
    while (row < 2) {
      sum = sum + array[row][column];
      row = row + 1;
    }
    column = column + 1;
  }
  return sum;
}

int row_sum(int row[], int size) {
  int index = 0;
  int sum = 0;
  while (index < size) {
    sum = sum + row[index];
    index = index + 1;
  }
  return sum;
}

int main() {
  putint(column_sum(hot, 8));
  putch(10);
  putint(mixed_sum(mixed_a) + mixed_sum(mixed_b));
  putch(10);
  putint(row_sum(escaped[1], 3));
  putch(10);
  return 0;
}

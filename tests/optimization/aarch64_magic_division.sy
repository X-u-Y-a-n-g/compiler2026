void print_quotients(int value) {
  putint(value / 3);
  putch(32);
  putint(value / -3);
  putch(32);
  putint(value / 5);
  putch(32);
  putint(value / -5);
  putch(32);
  putint(value / 7);
  putch(32);
  putint(value / -7);
  putch(32);
  putint(value / 10);
  putch(32);
  putint(value / -10);
  putch(32);
  putint(value / 11);
  putch(32);
  putint(value / -11);
  putch(32);
  putint(value / 1073741825);
  putch(32);
  putint(value / -1073741825);
  putch(32);
  putint(value / 2147483647);
  putch(32);
  putint(value / -2147483647);
  putch(32);
  putint(value / 2);
  putch(32);
  putint(value / -8);
  putch(10);
}

int main() {
  int count = getint();
  int index = 0;
  while (index < count) {
    print_quotients(getint());
    index = index + 1;
  }
  return 0;
}

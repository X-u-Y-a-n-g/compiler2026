int read_zero_24(int index) {
  int values[24] = {};
  if (index < 0 || index >= 24) {
    return -1;
  }
  return values[index];
}

int read_zero_9(int index) {
  int values[9] = {};
  if (index < 0 || index >= 9) {
    return -2;
  }
  return values[index];
}

int read_zero_7(int index) {
  int values[7] = {};
  if (index < 0 || index >= 7) {
    return -3;
  }
  return values[index];
}

int read_nonzero_8(int index) {
  int values[8] = {1, 2, 3, 4, 5, 6, 7, 8};
  if (index < 0 || index >= 8) {
    return -4;
  }
  return values[index];
}

int main() {
  int index = getint();
  putint(read_zero_24(index));
  putch(10);
  putint(read_zero_9(index));
  putch(10);
  putint(read_zero_7(index));
  putch(10);
  putint(read_nonzero_8(index));
  putch(10);
  return 0;
}

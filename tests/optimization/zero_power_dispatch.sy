int scale_by_dispatch(int value, int amount) {
    if (amount == 1) return value * 2;
    if (amount == 2) return value * 4;
    if (amount == 3) return value * 8;
    if (amount == 4) return value * 16;
    return value;
}

void print_line(int value) {
    putint(value);
    putch(10);
}

int main() {
    print_line(scale_by_dispatch(7, 0));
    print_line(scale_by_dispatch(-7, 0));
    print_line(scale_by_dispatch(3, 3));
    print_line(scale_by_dispatch(3, 5));
    return 0;
}

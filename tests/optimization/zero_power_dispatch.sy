int scale_by_dispatch(int value, int amount) {
    if (amount == 1) return value * 2;
    if (amount == 2) return value * 4;
    if (amount == 3) return value * 8;
    if (amount == 4) return value * 16;
    return value;
}

int divide_by_dispatch(int value, int amount) {
    if (amount == 1) return value / 2;
    if (amount == 2) return value / 4;
    if (amount == 3) return value / 8;
    if (amount == 4) return value / 16;
    return value;
}

int divide_through_parameter(int value, int amount) {
    return divide_by_dispatch(value, amount);
}

void print_line(int value) {
    putint(value);
    putch(10);
}

int main() {
    print_line(scale_by_dispatch(7, 0));
    print_line(scale_by_dispatch(-7, 0));
    print_line(scale_by_dispatch(3, 3));
    print_line(scale_by_dispatch(3, 5));
    print_line(scale_by_dispatch(7, -1));
    print_line(scale_by_dispatch(7, 31));
    print_line(divide_by_dispatch(31, 1));
    print_line(divide_by_dispatch(-31, 1));
    print_line(divide_by_dispatch(-31, 2));
    print_line(divide_by_dispatch(-2147483647 - 1, 4));
    print_line(divide_by_dispatch(31, 0));
    print_line(divide_by_dispatch(-31, -1));
    print_line(divide_by_dispatch(31, 31));
    print_line(divide_through_parameter(-127, 1));
    print_line(divide_through_parameter(-127, 4));
    return 0;
}

int shared_values[20];

int update_alias(int first[], int second[], int limit) {
  int position = 0;
  int checksum = 0;
  while (position < limit) {
    if (position > 0) {
      if (first[position] < first[position - 1]) {
        first[position] = first[position - 1];
      }
    }
    if (first[position] < second[position]) {
      first[position] = second[position];
    }
    int scan = 0;
    while (scan < position) {
      if (first[position] < second[scan]) {
        first[position] = second[scan];
      }
      scan = scan + 1;
    }
    checksum = checksum + first[position];
    position = position + 1;
  }
  return checksum;
}

int main() {
  int index = 0;
  while (index < 20) {
    shared_values[index] = index * 5 - 13;
    index = index + 1;
  }
  putint(update_alias(shared_values, shared_values, 8));
  putch(10);
  return 0;
}

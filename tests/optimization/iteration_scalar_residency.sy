int tiles[9][17];
int weights[9][17];
int left_values[24];
int right_values[24];

int update_tile(int row, int limit) {
  int column = 0;
  int checksum = 0;
  while (column < limit) {
    if (column > 0) {
      if (tiles[row][column] < tiles[row][column - 1]) {
        tiles[row][column] = tiles[row][column - 1];
      }
    }
    if (tiles[row][column] < weights[row][column]) {
      tiles[row][column] = weights[row][column];
    }
    int scan = 0;
    while (scan < column) {
      if (tiles[row][column] < weights[row][scan]) {
        tiles[row][column] = weights[row][scan];
      }
      scan = scan + 1;
    }
    checksum = checksum + tiles[row][column];
    column = column + 1;
  }
  return checksum;
}

int update_distinct(int first[], int second[], int limit) {
  int position = 0;
  int checksum = 0;
  while (position < limit) {
    if (position > 0) {
      if (first[position] < first[position - 1]) {
        first[position] = first[position - 1];
      }
    }
    if (first[position] < second[position]) {
      first[position] = second[position];
    }
    int scan = 0;
    while (scan < position) {
      if (first[position] < second[scan]) {
        first[position] = second[scan];
      }
      scan = scan + 1;
    }
    checksum = checksum + first[position];
    position = position + 1;
  }
  return checksum;
}

int main() {
  int index = 0;
  while (index < 17) {
    tiles[3][index] = index - 9;
    weights[3][index] = 12 - index * 2;
    index = index + 1;
  }
  index = 0;
  while (index < 24) {
    left_values[index] = 2147483640 - index;
    right_values[index] = index * 7 - 20;
    index = index + 1;
  }

  putint(update_tile(3, 0));
  putch(10);
  putint(update_tile(3, 7));
  putch(10);
  putint(update_distinct(left_values, right_values, 6));
  putch(10);
  return 0;
}

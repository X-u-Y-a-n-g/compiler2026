int stable_state[4];
int changing_state[2];
int results[8];

int sum_stable(int key) {
  int index = 0;
  int sum = 0;
  while (index < 4) {
    sum = sum + stable_state[(index + key) % 4];
    index = index + 1;
  }
  return sum;
}

int sum_changing(int key) {
  int index = 0;
  int sum = 0;
  while (index < 2) {
    sum = sum + changing_state[index] + key;
    index = index + 1;
  }
  return sum;
}

int main() {
  stable_state[0] = 2;
  stable_state[1] = 3;
  stable_state[2] = 5;
  stable_state[3] = 7;
  changing_state[0] = 1;
  changing_state[1] = 2;

  int total = 0;
  int index = 0;
  while (index < 8) {
    results[index] = sum_stable(index % 3);
    total = total + results[index];
    index = index + 1;
  }
  putint(total);
  putch(10);

  total = 0;
  index = 0;
  while (index < 4) {
    total = total + sum_changing(index % 2);
    changing_state[0] = changing_state[0] + 1;
    index = index + 1;
  }
  putint(total);
  putch(10);
  return 0;
}

int positive_scan(int count) {
    int state = 1000;
    int index = 0;
    while (index < count) {
        state = (state + index % 17 + 1) % 1009;
        index = index + 1;
    }
    return state;
}

int negative_scan(int count) {
    int state = -1000;
    int index = 0 - count;
    while (index < 0) {
        state = (state + index % 17 - 1) % 1009;
        index = index + 1;
    }
    return state;
}

int mixed_scan(int count, int start, int step) {
    int state = 0;
    int index = start;
    while (index < count) {
        state = (state + index % 17 + 1) % 1009;
        index = index + step;
    }
    return state;
}

int main() {
    int cases = getint();
    while (cases > 0) {
        int count = getint();
        int start = getint();
        int step = getint();
        putint(positive_scan(count));
        putch(10);
        putint(negative_scan(count));
        putch(10);
        putint(mixed_scan(count, start, step));
        putch(10);
        cases = cases - 1;
    }
    return 0;
}

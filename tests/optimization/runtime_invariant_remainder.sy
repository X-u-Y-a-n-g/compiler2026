int divisor;
int values[32];
int results[32];

int runtime_remainder(int value) {
    return value % divisor;
}

int main() {
    divisor = getint();
    int count = getarray(values);
    int index = 0;
    while (index < count) {
        results[index] = runtime_remainder(values[index]);
        index = index + 1;
    }
    putarray(count, results);
    return 0;
}

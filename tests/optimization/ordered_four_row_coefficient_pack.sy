int payload[48][48];
int weights[48][48];
int workspace[48][48];

int main() {
    int count = getint();
    int row = 0;
    while (row < 48) {
        int column = 0;
        while (column < 48) {
            payload[row][column] =
                (row * 9 + column * 5 + 3) % 19 - 9;
            weights[row][column] =
                (row * 7 - column * 11 + 13) % 15 - 7;
            workspace[row][column] = row - column;
            column = column + 1;
        }
        row = row + 1;
    }

    row = 0;
    while (row < count) {
        if (row >= count / 3) {
            int column = 0;
            while (column < count) {
                payload[row][column] = 0 - 2;
                column = column + 1;
            }
        }
        row = row + 1;
    }

    row = 0;
    while (row < count) {
        int column = 0;
        while (column < count) {
            int reduction = 0;
            int sum = 0;
            while (reduction < count) {
                sum = sum + weights[row][reduction] *
                    payload[reduction][column];
                reduction = reduction + 1;
            }
            payload[row][column] = sum;
            column = column + 1;
        }
        row = row + 1;
    }

    int result = 0;
    row = 0;
    while (row < 48) {
        int column = 0;
        while (column < 48) {
            result = result * 29 + payload[row][column];
            column = column + 1;
        }
        row = row + 1;
    }
    putint(result);
    putch(10);
    return 0;
}

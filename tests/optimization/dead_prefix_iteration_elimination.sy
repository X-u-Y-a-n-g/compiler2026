int data[8];
int side_effect_count;

int prefix_sum(int values[], int length) {
  int i = 0;
  int sum = 0;
  while (i < length) {
    sum = sum + values[i];
    i = i + 1;
  }
  return sum;
}

int last_only(int count, int values[]) {
  int result = 77;
  while (count != 0) {
    result = prefix_sum(values, count);
    count = count - 1;
  }
  return result;
}

int accumulating_fallback(int count, int values[]) {
  int result = 0;
  while (count != 0) {
    result = result + prefix_sum(values, count);
    count = count - 1;
  }
  return result;
}

int effectful(int value) {
  side_effect_count = side_effect_count + 1;
  return value * 3;
}

int effect_fallback(int count) {
  int result = 0;
  while (count != 0) {
    result = effectful(count);
    count = count - 1;
  }
  return result;
}

int dynamic_division_fallback(int count, int divisor) {
  int result = 0;
  while (count != 0) {
    result = count / divisor;
    count = count - 1;
  }
  return result;
}

int recursive_readonly(int value) {
  if (value == 0) {
    return 0;
  }
  return recursive_readonly(value - 1) + 1;
}

int recursive_fallback(int count) {
  int result = 91;
  while (count != 0) {
    result = recursive_readonly(count);
    count = count - 1;
  }
  return result;
}

int main() {
  int i = 0;
  while (i < 8) {
    data[i] = i + 1;
    i = i + 1;
  }

  putint(last_only(0, data));
  putch(10);
  putint(last_only(1, data));
  putch(10);
  putint(last_only(5, data));
  putch(10);

  putint(accumulating_fallback(4, data));
  putch(10);

  side_effect_count = 0;
  putint(effect_fallback(4));
  putch(10);
  putint(side_effect_count);
  putch(10);

  putint(dynamic_division_fallback(4, 2));
  putch(10);
  putint(recursive_fallback(0));
  putch(10);
  return 0;
}

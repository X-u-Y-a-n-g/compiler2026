int source[8] = {0, 1, 2, 3, 4, 5, 6, 7};
int values[8];
int state;

int changing_transform() {
    int i = 0;
    while (i < 8) {
        values[i] = source[i] + state;
        i = i + 1;
    }
    state = state + 1;
    return state;
}

int main() {
    int remaining = 5;
    int result = 0;
    state = 0;
    while (remaining > 0) {
        result = changing_transform();
        remaining = remaining - 1;
    }
    putint(result);
    putch(32);
    putint(state);
    putch(32);
    putint(values[7]);
    putch(10);
    return 0;
}

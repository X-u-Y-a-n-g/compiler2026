int table[97][97];
int fallback_data[16];

int fallback(int count) {
    int current = 0;
    int k = 0;
    while (k < count) {
        int value = fallback_data[k];
        fallback_data[k] = value + 1;
        if (current < value) {
            current = value * 3;
        }
        k = k + 1;
    }
    return current;
}

int run_ordered(int count, int data[][97]) {
    int i;
    int j;
    int k;
    i = count - 1;
    while (i >= 0) {
        j = i + 1;
        while (j < count) {
            if (j - 1 >= 0) {
                if (data[i][j] < data[i][j - 1]) {
                    data[i][j] = data[i][j - 1];
                }
            }
            if (i + 1 < count) {
                if (data[i][j] < data[i + 1][j]) {
                    data[i][j] = data[i + 1][j] * 2;
                }
            }
            if (j - 1 >= 0 && i + 1 < count) {
                if (i < j - 1) {
                    if (data[i][j] < data[i + 1][j - 1] + 3) {
                        data[i][j] = data[i + 1][j - 1] + 3;
                    }
                } else {
                    if (data[i][j] < data[i + 1][j - 1]) {
                        data[i][j] = data[i + 1][j - 1];
                    }
                }
            }
            k = i + 1;
            while (k < j) {
                if (data[i][j] < data[i][k] + data[k + 1][j]) {
                    data[i][j] =
                        data[i][k] * 2 + data[k + 1][j];
                }
                k = k + 1;
            }
            j = j + 1;
        }
        i = i - 1;
    }

    int checksum = 0;
    i = 0;
    while (i < count) {
        int j = 0;
        while (j < count) {
            checksum = checksum * 31 + data[i][j];
            j = j + 1;
        }
        i = i + 1;
    }
    return checksum;
}

int main() {
    int i = 0;
    while (i < 12) {
        int j = 0;
        while (j < 12) {
            table[i][j] =
                i * 123456789 + j * 987654321 + 5;
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    while (i < 16) {
        fallback_data[i] = i - 8;
        i = i + 1;
    }

    int checksum = 0;
    i = 0;
    while (i <= 9) {
        checksum = checksum * 31 + run_ordered(i, table);
        i = i + 1;
    }
    checksum = checksum * 31 + fallback(9);
    putint(checksum);
    putch(10);
    return 0;
}

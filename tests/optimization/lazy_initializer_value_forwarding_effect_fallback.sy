int payload[64];
int widths[8];
int observed;

int remap_with_pure_copy(int total, int data[], int width) {
  int height = total / width;
  int row = 0;
  int column = 0;
  while (row < height) {
    column = 0;
    while (column < width) {
      if (row < column) {
        column = column + 1;
        continue;
      }
      int value = data[row * width + column];
      data[column * height + row] = data[row * width + column];
      data[row * width + column] = value;
      column = column + 1;
    }
    row = row + 1;
  }
  return -1;
}

int main() {
  int total = getint();
  int length = 3;
  widths[0] = 2;
  widths[1] = 3;
  widths[2] = 4;

  int cursor = 0;
  while (cursor < total) {
    payload[cursor] = cursor * 5 + 1;
    observed = observed + cursor;
    cursor = cursor + 1;
  }

  cursor = 0;
  while (cursor < length) {
    remap_with_pure_copy(total, payload, widths[cursor]);
    cursor = cursor + 1;
  }

  int result = observed;
  cursor = 0;
  while (cursor < length) {
    result = result + cursor * payload[cursor];
    cursor = cursor + 1;
  }
  putint(result);
  putch(10);
  return 0;
}

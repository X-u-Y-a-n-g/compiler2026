int panel_coefficients[40][40];
int panel_state[40][40];
int panel_sizes[4];

void initialize_panel_state(int seed) {
    int row = 0;
    while (row < 40) {
        int column = 0;
        while (column < 40) {
            panel_coefficients[row][column] =
                (row * 13 + column * 7 + seed) % 17 - 8;
            panel_state[row][column] =
                (row * 5 - column * 11 + seed * 3) % 19 - 9;
            column = column + 1;
        }
        row = row + 1;
    }
}

void update_panel_state(int size) {
    int row = 0;
    while (row < size) {
        int column = 0;
        while (column < size) {
            int reduction = 0;
            int sum = 0;
            while (reduction < size) {
                sum = sum +
                    panel_coefficients[row][reduction] *
                    panel_state[reduction][column];
                reduction = reduction + 1;
            }
            panel_state[row][column] = sum;
            column = column + 1;
        }
        row = row + 1;
    }
}

int panel_checksum() {
    int checksum = 0;
    int row = 0;
    while (row < 40) {
        int column = 0;
        while (column < 40) {
            checksum = checksum * 29 + panel_state[row][column];
            column = column + 1;
        }
        row = row + 1;
    }
    return checksum;
}

int main() {
    int test = 0;
    while (test < 4) {
        panel_sizes[test] = getint();
        test = test + 1;
    }
    test = 0;
    while (test < 4) {
        initialize_panel_state(test + 1);
        update_panel_state(panel_sizes[test]);
        putint(panel_checksum());
        putch(10);
        test = test + 1;
    }
    return 0;
}

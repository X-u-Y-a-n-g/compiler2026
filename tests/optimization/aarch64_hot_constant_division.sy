int positive_constants(int x, int count) {
  int result = 0;
  int i = 0;
  while (i < count) {
    result = result + x / 3;
    result = result + x % 3;
    result = result + x / 1000;
    result = result + x % 1000;
    x = x + 2147483647;
    i = i + 1;
  }
  return result;
}

int negative_constants(int x, int count) {
  int result = 0;
  int i = 0;
  while (i < count) {
    result = result + x / -3;
    result = result + x % -3;
    result = result + x / -7;
    result = result + x % -7;
    x = x * 1664525 + 1013904223;
    i = i + 1;
  }
  return result;
}

int large_constants(int x, int count) {
  int result = 0;
  int i = 0;
  while (i < count) {
    result = result + x / 19491001;
    result = result + x % 19491001;
    result = result + x / 998244853;
    result = result + x % 998244853;
    x = x * 1103515245 + 12345;
    i = i + 1;
  }
  return result;
}

int opaque(int x) {
  if (x <= 0) {
    return 0;
  }
  return opaque(x - 1000000000) + 1;
}

int call_fallback(int x, int count) {
  int result = 0;
  int i = 0;
  while (i < count) {
    result = result + x / 5 + opaque(x);
    result = result + x % 5;
    x = x + 17;
    i = i + 1;
  }
  return result;
}

int cold_fallback(int x) {
  return x / 11 + x % 11;
}

int two_loops(int x) {
  int result = 0;
  int i = 0;
  while (i < 3) {
    result = result + x / -13 + x % -13;
    x = x * 33 + 7;
    i = i + 1;
  }
  i = 0;
  while (i < 4) {
    result = result + x / 17 + x % 17;
    x = x * 65 - 11;
    i = i + 1;
  }
  return result;
}

int main() {
  int a = getint();
  int b = getint();
  int c = getint();
  int d = getint();
  int e = getint();
  int f = getint();
  putint(positive_constants(a, 0));
  putch(10);
  putint(positive_constants(b, 1));
  putch(10);
  putint(positive_constants(c, 7));
  putch(10);
  putint(negative_constants(d, 9));
  putch(10);
  putint(large_constants(e, 5));
  putch(10);
  putint(large_constants(f, 8));
  putch(10);
  putint(call_fallback(c, 3));
  putch(10);
  putint(cold_fallback(a));
  putch(10);
  putint(two_loops(d));
  putch(10);
  return 0;
}
